{
    "name": "msstc4php/vo-identifiers",
    "description": "Value objects for publication and media identifiers (ISBN, ISSN, ISRC, DOI, ORCID and others), transport and logistics identifiers (VIN, container number, IMO, MMSI), telecom identities (IMEI, ICCID, IMSI, EID) and chemistry, trade and energy identifiers (CAS, EC, HS, EIC, MPAN). (CI profile: CI-only tools)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "identifiers",
        "isbn",
        "issn",
        "ismn",
        "isrc",
        "iswc",
        "isan",
        "isni",
        "orcid",
        "doi",
        "ror",
        "ark",
        "vin",
        "wmi",
        "container-number",
        "imo",
        "mmsi",
        "imei",
        "iccid",
        "imsi",
        "eid",
        "cas",
        "eic",
        "mpan",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/vo-base"
        },
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/vo-gs1"
        }
    ],
    "require": {
        "msstc4php/vo-base": "^1.4",
        "msstc4php/vo-gs1": "dev-main as 1.0.0",
        "php": ">=8.4"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.6",
        "friendsofphp/php-cs-fixer": "^3.76",
        "infection/infection": "^0.32",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": ">=11.0",
        "rector/rector": "^2.1",
        "roave/backward-compatibility-check": "^8.20",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Identifiers\\": "src/"
        },
        "files": [
            "src/Transport/MmsiType.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Identifiers\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "extra": {
        "bundle-standard": {
            "kind": "library",
            "runtime": "php84"
        }
    }
}
